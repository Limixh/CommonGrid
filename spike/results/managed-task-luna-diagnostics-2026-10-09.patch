diff --git a/sum.mjs b/sum.mjs
index 66aa6f7..d1177a6 100644
--- a/sum.mjs
+++ b/sum.mjs
@@ -1 +1,14 @@
-export function sumIntegers(values) { return values.reduce((total, value) => total + value); }
+export function sumIntegers(values) {
+  if (!Array.isArray(values) || !values.every(Number.isSafeInteger)) {
+    throw new TypeError('values must be an array of safe integers');
+  }
+
+  let total = 0;
+  for (const value of values) {
+    total += value;
+    if (!Number.isSafeInteger(total)) {
+      throw new RangeError('running sum is not a safe integer');
+    }
+  }
+  return total;
+}
