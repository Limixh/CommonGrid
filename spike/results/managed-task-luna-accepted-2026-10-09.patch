diff --git a/sum.mjs b/sum.mjs
index 66aa6f7..20bf69d 100644
--- a/sum.mjs
+++ b/sum.mjs
@@ -1 +1,20 @@
-export function sumIntegers(values) { return values.reduce((total, value) => total + value); }
+export function sumIntegers(values) {
+  if (!Array.isArray(values)) {
+    throw new TypeError('values must be an array');
+  }
+
+  let total = 0;
+  for (let index = 0; index < values.length; index += 1) {
+    const value = values[index];
+    if (!Number.isSafeInteger(value)) {
+      throw new TypeError('values must contain only safe integers');
+    }
+
+    total += value;
+    if (!Number.isSafeInteger(total)) {
+      throw new RangeError('sum exceeds the safe integer range');
+    }
+  }
+
+  return total;
+}
