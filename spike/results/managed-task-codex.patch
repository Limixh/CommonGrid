diff --git a/sum.mjs b/sum.mjs
index 66aa6f7..8520b66 100644
--- a/sum.mjs
+++ b/sum.mjs
@@ -1 +1,18 @@
-export function sumIntegers(values) { return values.reduce((total, value) => total + value); }
+export function sumIntegers(values) {
+  if (!Array.isArray(values)) {
+    throw new TypeError('Expected an array of safe integers');
+  }
+  for (let i = 0; i < values.length; i++) {
+    if (!Number.isSafeInteger(values[i])) {
+      throw new TypeError('Expected an array of safe integers');
+    }
+  }
+  let total = 0;
+  for (let i = 0; i < values.length; i++) {
+    total += values[i];
+    if (!Number.isSafeInteger(total)) {
+      throw new RangeError('Running sum is not a safe integer');
+    }
+  }
+  return total;
+}
