diff --git a/sum.mjs b/sum.mjs
index 66aa6f7..8d86566 100644
--- a/sum.mjs
+++ b/sum.mjs
@@ -1 +1,10 @@
-export function sumIntegers(values) { return values.reduce((total, value) => total + value); }
+export function sumIntegers(values) {
+  if (!Array.isArray(values)) throw new TypeError('Expected an array');
+  let total = 0;
+  for (const value of values) {
+    if (!Number.isSafeInteger(value)) throw new TypeError('Expected safe integers');
+    total += value;
+    if (!Number.isSafeInteger(total)) throw new RangeError('Unsafe sum');
+  }
+  return total;
+}
