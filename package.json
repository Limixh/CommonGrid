{
  "name": "commongrid",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/task-schema",
    "packages/agent-adapters"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "npm run dev -w @commongrid/desktop",
    "dev:api": "node scripts/go.mjs run ./cmd/coordinator",
    "desktop": "node scripts/native.mjs dev",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit && npm run typecheck -w @commongrid/desktop",
    "test": "npm run test:product && npm run test:spike-fixtures",
    "test:product": "node --test scripts/test/tool-probes.test.mjs && tsx --test --test-concurrency=4 scripts/test/native-ui-trace.test.mts packages/task-schema/test/*.test.ts packages/agent-adapters/test/*.test.ts && node scripts/go.mjs test ./...",
    "test:spike-fixtures": "node --test scripts/test/cli-wire-inventory.test.mjs scripts/test/task-broker.test.mjs scripts/test/tunnel-wire.test.mjs && tsx --test spike/cli-session/*.test.mjs spike/cli-session/*.test.mts",
    "build": "npm run build -w @commongrid/desktop && node scripts/go.mjs build ./...",
    "check": "npm run generate:check && npm run typecheck && npm test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "test:ui": "node scripts/ui-tests.mjs",
    "test:native": "node scripts/rust.mjs test --locked",
    "test:native-smoke": "node --import tsx scripts/native-journal-smoke.mts",
    "test:native-cli-smoke": "node --import tsx scripts/native-cli-smoke.mts",
    "test:native-profile-smoke": "node --import tsx scripts/native-profile-smoke.mts",
    "test:native-session-smoke": "node --import tsx scripts/native-session-smoke.mts",
    "test:native-task-smoke": "node --import tsx scripts/native-task-smoke.mts",
    "prepare:native-launcher": "node scripts/native-launcher-assets.mjs",
    "test:spike": "node scripts/spike.mjs test",
    "test:db": "node scripts/postgres-tests.mjs",
    "test:native-cloud-ui": "node scripts/postgres-tests.mjs --cloud-ui",
    "db:migrate": "node scripts/go.mjs run ./cmd/db migrate",
    "spike:recovery": "node scripts/spike.mjs recovery",
    "spike:routing": "node spike/cli-routing/probe.mjs",
    "spike:sandbox": "node scripts/sandbox-tests.mjs",
    "spike:cli-session": "node scripts/cli-session-tests.mjs",
    "spike:account-smoke": "node --import tsx spike/cli-session/account-smoke.mts",
    "spike:managed-session": "node --import tsx spike/cli-session/managed-session.mts",
    "spike:session-acceptance": "node --import tsx spike/cli-session/managed-session-acceptance.mts",
    "spike:session-continuity": "node --import tsx spike/cli-session/managed-continuity.mts",
    "spike:owner-crash": "node --import tsx spike/cli-session/managed-owner-crash.mts",
    "spike:coding-verifier": "node --import tsx spike/cli-session/coding-verifier.mts",
    "spike:managed-boundary": "node --import tsx spike/cli-session/managed-boundary.mts",
    "spike:managed-adversarial": "node --import tsx spike/cli-session/managed-adversarial.mts",
    "spike:managed-task": "node --import tsx spike/cli-session/managed-task.mts",
    "install:temporal": "node scripts/install-temporal.mjs",
    "install:trivy": "node scripts/install-trivy.mjs",
    "test:artifacts": "node scripts/artifact-tests.mjs",
    "install:cli-fixtures": "node scripts/install-cli-fixtures.mjs",
    "install:browsers": "node scripts/ui-tests.mjs install chromium --only-shell"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.13.10",
    "esbuild": "0.25.12",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
