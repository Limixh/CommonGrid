{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommonGrid", "version": "0.1.0", "identifier": "org.commongrid.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "CommonGrid", "width": 1380, "height": 900, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false, "resources": { "resources/launcher/": "launcher/" } }
}
