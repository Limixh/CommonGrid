{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true, "allowJs": true,
    "skipLibCheck": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "spike/cli-session/*.mts", "apps/desktop/native-worker/**/*.ts"]
}
